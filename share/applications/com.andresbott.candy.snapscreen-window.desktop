[Desktop Entry]
Type=Application
Name=Snapscreen (capture window)
Comment=Take a screenshot of a window
Exec=/usr/local/bin/candy snapscreen -t w
Icon=camera-photo
Terminal=false
# NoDisplay keeps it out of the app menu; it exists only to carry the shortcut.
NoDisplay=true
# Default KDE global shortcut (kglobalaccel reads this); the user can override it.
X-KDE-Shortcuts=Meta+Shift+W
